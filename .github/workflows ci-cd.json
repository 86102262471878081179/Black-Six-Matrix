# 1. Erstelle die Datei direkt mit cat (ohne Editor)
cat > .github/workflows/ci-cd.yml << 'EOF'
name: "OMNI-CORE CI/CD Pipeline"

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]

jobs:
  validate-and-test:
    runs-on: ubuntu-latest
    steps:
      - name: "Code auschecken"
        uses: actions/checkout@v4

      - name: "Go Umgebung einrichten"
        uses: actions/setup-go@v5
        with:
          go-version: '1.22'
          cache: true

      - name: "Abhängigkeiten installieren"
        run: |
          go mod download
          go mod tidy

      - name: "Kompilierung prüfen"
        run: |
          go build -v ./cmd/omni-proxy/...

  docker-build-check:
    needs: validate-and-test
    runs-on: ubuntu-latest
    steps:
      - name: "Code auschecken"
        uses: actions/checkout@v4

      - name: "Docker Buildx einrichten"
        uses: docker/setup-buildx-action@v3

      - name: "Multi-Stage Docker Image bauen"
        uses: docker/build-push-action@v5
        with:
          context: .
          file: ./Dockerfile
          push: false
          tags: omni-core-v20:latest
          cache-from: type=gha
          cache-to: type=gha,mode=max
EOF

# 2. Prüfen
cat .github/workflows/ci-cd.yml | head -5

# 3. Commit & Push
git add .github/workflows/ci-cd.yml
git commit -m "Φ_LOCKED_ABSOLUTE: YAML via cat (kein Editor)"
git push origin main
